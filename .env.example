# Copy to .env for local development. Never commit real values.
# In Vercel, scope every secret to Production only; use separate keys for Preview.

# Required: signs every link and receipt. openssl rand -base64 32
SIGNING_SECRET=

# Optional: Vercel Blob (waitlist, feedback, ref counts; rate limits when Supabase is off)
BLOB_READ_WRITE_TOKEN=

# Optional: AI estimate, drafting and proposal text (Anthropic)
ANTHROPIC_API_KEY=
ESTIMATE_DAILY_CAP=
AI_DAILY_CAP=
PROPOSAL_DAILY_CAP=
HIT_DAILY_CAP=

# Accounts (all three switch accounts on). The service role key is server-only.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Email notifications (Resend) and the daily reminder job
RESEND_API_KEY=
EMAIL_FROM=
APP_URL=
# openssl rand -hex 32
CRON_SECRET=

# Optional: Stripe test-mode links for the waitlist plans
STRIPE_LINK_PRO=
STRIPE_LINK_AGENCY=
