# Copy to .env for local development. Never commit real values.
# In Vercel, scope every secret to Production only; use separate keys for Preview.

# Required: signs every link and receipt. openssl rand -base64 32
SIGNING_SECRET=
# During a key rotation: the old key(s), comma-separated. Old links keep working only if they were
# filed in a project (SignedScope has a record of them). Remove once those links are no longer needed.
SIGNING_SECRET_PREVIOUS=

# Optional: Vercel Blob (waitlist, feedback, ref counts; rate limits when Supabase is off)
BLOB_READ_WRITE_TOKEN=

# Optional: AI estimate, drafting and proposal text (Anthropic)
ANTHROPIC_API_KEY=
ESTIMATE_DAILY_CAP=
AI_DAILY_CAP=
PROPOSAL_DAILY_CAP=
HIT_DAILY_CAP=
# Starter plan: open (unsigned) filed links per account. Unset during the beta = no limit.
STARTER_SCOPE_LIMIT=

# Accounts (all three switch accounts on). The service role key is server-only.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Email notifications (Resend) and the daily reminder job
RESEND_API_KEY=
EMAIL_FROM=
APP_URL=
# openssl rand -hex 32
CRON_SECRET=

# Billing (Stripe Payment Links + webhook at POST /api/checkout). Leave empty during the beta.
# Links: https://buy.stripe.com/...   Ids: plink_... (same links, from the Stripe dashboard)
STRIPE_LINK_PRO=
STRIPE_LINK_AGENCY=
STRIPE_PLINK_PRO=
STRIPE_PLINK_AGENCY=
# Webhook signing secret (whsec_...). Events: checkout.session.completed,
# customer.subscription.updated, customer.subscription.deleted
STRIPE_WEBHOOK_SECRET=
# Set during webhook secret rotation only
STRIPE_WEBHOOK_SECRET_PREVIOUS=
